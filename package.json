    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.0",
    "react-router-dom": "^6.20.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^3.3.6",
    "zod": "^3.22.4"
